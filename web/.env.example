# --- Zernio (server only) ---
ZERNIO_API_KEY=
# ZERNIO_API_URL=https://zernio.com/api/v1

# --- Firebase web app (Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FUNCTIONS_REGION=us-central1

# Local dev against the Firebase emulators (Auth 9099, Firestore 8080, Functions 5001)
NEXT_PUBLIC_USE_EMULATORS=false
# For firebase-admin when using emulators:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Local dev against a real project (not needed on App Hosting): path to the service account JSON,
# kept OUTSIDE the repo. Alternative: FIREBASE_SERVICE_ACCOUNT with the JSON on one line.
# GOOGLE_APPLICATION_CREDENTIALS=C:\claves\service-account.json

# --- Agente IA ---
# 32 bytes en hex; el mismo valor que el secreto DF_AI_ENCRYPTION_KEY de las funciones.
# Cifra la API key de OpenRouter de cada usuario.
DF_AI_ENCRYPTION_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Autolix
