{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "kafona",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "site": "kasita-crm",
      "source": "web",
      "frameworksBackend": {
        "region": "us-central1",
        "secrets": [
          "DF_AI_ENCRYPTION_KEY"
        ],
        "maxInstances": 10,
        "memory": "512MiB"
      }
    }
  ]
}
